# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string you choose yourself, used to verify the webhook
# with Meta. Put the same value in Meta's webhook setup screen.
WEBHOOK_VERIFY_TOKEN=choose_a_random_secret_string

# Groq API (console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/nails_bot

# Paystack (leave test mode off in production)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_TEST_MODE=false

# Server
PORT=3000

ADMIN_KEY=something_you_only_know

# Optional example seed tenant credentials
GLOW_NAILS_PHONE_NUMBER_ID=your_phone_number_id
GLOW_NAILS_WHATSAPP_TOKEN=your_meta_access_token
TEST_BEAUTY_PHONE_NUMBER_ID=another_phone_number_id
TEST_BEAUTY_WHATSAPP_TOKEN=another_meta_access_token